{
  "appId": "com.zdyr.universalbatch",
  "productName": "万能AI批量编辑器",
  "directories": {
    "app": "protected-main",
    "output": "release-installer"
  },
  "afterPack": "scripts/after-pack-icon.cjs",
  "files": [
    "dist/**/*",
    "src/main/**/*",
    "build/icon.ico",
    "notice.json",
    "使用和密钥注册教程.pdf",
    "微信.png",
    "公众号logo.jpg",
    "logo.jpg",
    "package.json"
  ],
  "extraFiles": [
    { "from": "使用和密钥注册教程.pdf", "to": "使用和密钥注册教程.pdf" },
    { "from": "微信.png", "to": "微信.png" },
    { "from": "公众号logo.jpg", "to": "公众号logo.jpg" },
    { "from": "logo.jpg", "to": "logo.jpg" }
  ],
  "win": {
    "icon": "build/icon.ico",
    "signAndEditExecutable": false,
    "target": ["nsis"],
    "artifactName": "万能AI批量编辑器-V3-安装包.${ext}"
  },
  "nsis": {
    "createDesktopShortcut": true,
    "shortcutName": "万能AI批量编辑器",
    "oneClick": true,
    "perMachine": false
  }
}
